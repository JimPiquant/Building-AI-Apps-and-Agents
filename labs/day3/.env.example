# Day 3 Lab environment file — copy to `.env` and fill in your values.
#
# Most values carry over from Day 1/2. New for Day 3: the shared workshop
# Azure DevOps organization/your own project within it (Part C/D) and the
# Foundry project client used for Part E's FoundryEvals judge.

# Same endpoint you used on Day 1/2 (your Foundry project).
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# Same model you used on Day 1/2. Recommended: gpt-5.6-luna.
FOUNDRY_MODEL=gpt-5.6-luna

# The workshop's shared, Entra-backed Azure DevOps Services organization,
# plus your own dedicated project within it (see the Prerequisites section
# of labs/day3/README.md). Do NOT point this at your organization's real
# production project.
AZURE_DEVOPS_ORG=<your-ado-org>
AZURE_DEVOPS_PROJECT=<your-ado-project>
AZURE_DEVOPS_TENANT_ID=<your-entra-tenant-id>

# A known work item in that project, seeded for Part C (read) and Part D
# (write) to exercise against. Reset it between runs if Part D mutates it.
AZURE_DEVOPS_WORK_ITEM_ID=42

# Model deployment used as the LLM judge for Part E's FoundryEvals.
# Can be the same deployment as FOUNDRY_MODEL.
EVALUATION_MODEL=gpt-5.6-sol
