# Day 4 Lab environment file — copy to `.env` and fill in your values.
#
# Every value here carries over from Day 1-3 — nothing new to provision for
# the core lab. The Retriever role reuses your Day 2 Foundry IQ knowledge
# base as-is (same knowledge base, same Azure AI Search service — nothing
# new to create). Azure DevOps variables are NOT needed here; the optional
# Ticket-agent stretch reuses Day 3's own `.env` and setup instead.

# Same endpoint you used on Day 1-3 (your Foundry project).
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# Same model you used on Day 1-3. Recommended: gpt-5.6-luna.
FOUNDRY_MODEL=gpt-5.6-luna

# Same Azure AI Search service URL you used on Day 2. Get it from the
# Search service's Overview page in the Azure portal. No trailing slash.
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net

# Same Foundry IQ knowledge base name you created on Day 2 (see
# labs/day2/README.md's Prerequisites section) — the Retriever role
# grounds against this, unchanged.
FOUNDRY_IQ_KNOWLEDGE_NAME=contoso-docs

# Model deployment used as the LLM judge for the trajectory evaluation
# (Module 5) across all three parts. Can be the same deployment as
# FOUNDRY_MODEL, but a separate, usually smaller judge deployment is
# preferred — reusing the production model as its own judge is a
# documented conflict of interest (Day 2 Module 3).
EVALUATION_MODEL=gpt-5.6-sol
