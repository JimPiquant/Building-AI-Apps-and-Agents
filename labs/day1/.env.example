# Copy this file to `.env` in the same directory and fill in the values.
# Never commit `.env`.

# --- Required for every part ---
# Your Foundry project endpoint (from Module 2 — the portal tour)
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# --- Part A: Prompt agent (created in the Foundry portal) ---
FOUNDRY_PROMPT_AGENT_NAME=docs-assistant
FOUNDRY_PROMPT_AGENT_VERSION=1

# --- Part B: Hosted agent (deploy yourself via `azd` — see part_b_deploy_hosted_agent.md) ---
FOUNDRY_HOSTED_AGENT_NAME=docs-assistant-hosted

# --- Part C: your code + Responses API ---
# The deployment name of a chat-capable model in your Foundry project.
# This is the *deployment* name in the portal, not the model name.
# Recommended: gpt-5.6-luna (good balance of capability and cost for this workshop).
FOUNDRY_MODEL=gpt-5.6-luna
