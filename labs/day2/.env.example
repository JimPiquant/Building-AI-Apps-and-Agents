# Day 2 Lab environment file — copy to `.env` and fill in your values.
#
# Most values carry over from Day 1. New for Day 2: the IQ knowledge source name.

# Same endpoint you used on Day 1 (your Foundry project).
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# Same model you used on Day 1. Recommended: gpt-5.6-luna.
FOUNDRY_MODEL=gpt-5.6.luna

# Name of the Foundry IQ knowledge source you'll create in Part A.
# You can leave this default and the create_iq_source.py script will use it.
FOUNDRY_IQ_KNOWLEDGE_NAME=contoso-docs

# New for day 2 - model that serves as a judge for evaluations
EVALUATION_MODEL=gpt-5.6-luna

# Reuse the Day 1 Prompt agent as the starting point? (optional)
# If set, Part A attaches IQ to your Day 1 agent. If unset, Part A creates
# a new local MAF agent for Day 2 — either works, the lab uses the local one
# by default because it's less coupled to Day 1's Foundry state.
# FOUNDRY_PROMPT_AGENT_NAME=docs-assistant
# FOUNDRY_PROMPT_AGENT_VERSION=1.0
