# Day 2 Lab environment file — copy to `.env` and fill in your values.
#
# Most values carry over from Day 1. New for Day 2: the IQ knowledge base
# details and the Azure AI Search endpoint that hosts it.

# Same endpoint you used on Day 1 (your Foundry project).
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# Same model you used on Day 1. Recommended: gpt-5.6-luna.
FOUNDRY_MODEL=gpt-5.6-luna

# Azure AI Search service URL. Get it from the Search service's Overview page
# in the Azure portal. No trailing slash. No /openai suffix.
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net

# Name of the Foundry IQ knowledge base you created in the Foundry portal
# (see the Prerequisites section of labs/day2/README.md).
FOUNDRY_IQ_KNOWLEDGE_NAME=contoso-docs

# Azure OpenAI resource root for the evaluator's LLM-as-judge (Part A eval).
# For a Foundry resource, this is the same account root as your Foundry
# project endpoint. No trailing slash, no /openai suffix.
AZURE_OPENAI_ENDPOINT=https://<foundry-resource>.openai.azure.com

# Model that serves as a judge for evaluations in Part A.
EVALUATION_MODEL=gpt-5.6-luna

# Reuse the Day 1 Prompt agent as the starting point? (optional)
# If set, Part A attaches IQ to your Day 1 agent. If unset, Part A creates
# a new local MAF agent for Day 2 — either works, the lab uses the local one
# by default because it's less coupled to Day 1's Foundry state.
# FOUNDRY_PROMPT_AGENT_NAME=docs-assistant
# FOUNDRY_PROMPT_AGENT_VERSION=1
